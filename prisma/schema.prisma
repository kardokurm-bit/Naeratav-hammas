generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatSession {
  id          String    @id @default(cuid())
  title       String    @default("Uus vestlus")
  model       String    @default("gpt-4")
  temperature Float     @default(0.7)
  topP        Float     @default(1.0)
  promptId    String?
  /// Anonymous per-browser ID (cookie) of the chat's owner; null for chats created before ownership existed.
  ownerId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@index([ownerId, updatedAt])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SystemPrompt {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
}

model FaqEntry {
  id        String   @id @default(cuid())
  keywords  String
  question  String   @default("")
  answer    String
  createdAt DateTime @default(now())
}
